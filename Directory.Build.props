<Project>
  <PropertyGroup>
    <Product>AtlasOps</Product>
    <Title>AtlasOps</Title>
    <AssemblyTitle>AtlasOps</AssemblyTitle>
    <Company>AtlasOps</Company>
    <Copyright>Copyright © 2026 AtlasOps contributors</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <NoWarn>NU1701;NU1702;NU1510;CS1998;CS8669</NoWarn>
    <WarningsNotAsErrors>NU1901,NU1902,NU1903,NU1904</WarningsNotAsErrors>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
