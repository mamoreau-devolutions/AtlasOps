<Project>
  <PropertyGroup>
    <Product>AtlasOps</Product>
    <Title>AtlasOps</Title>
    <AssemblyTitle>AtlasOps</AssemblyTitle>
    <Company>AtlasOps</Company>
    <Copyright>Copyright © 2026 AtlasOps contributors</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <NoWarn>NU1701;NU1702;NU1510;CS1998;CS8669</NoWarn>
    <WarningsNotAsErrors>NU1901,NU1902,NU1903,NU1904</WarningsNotAsErrors>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <!--
    Every production project is declared trimming and NativeAOT compatible. This enables the trim,
    single-file, and AOT analyzers and marks the assemblies as trimmable. Tests and the Roslyn
    generator (netstandard2.0, loaded by the compiler) are excluded.
  -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.StartsWith('$(MSBuildThisFileDirectory)src')) and '$(MSBuildProjectName)' != 'AtlasOps.Generators'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
