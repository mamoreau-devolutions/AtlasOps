<views:MainWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:AtlasOps.Core;assembly=AtlasOps.Core"
    xmlns:composition="clr-namespace:AtlasOps.Composition;assembly=AtlasOps.Composition"
    xmlns:generated="clr-namespace:AtlasOps.Core.Generated;assembly=AtlasOps.Core"
    xmlns:features="clr-namespace:AtlasOps.Features;assembly=AtlasOps.Features"
    xmlns:geography="clr-namespace:AtlasOps.Geography.Views;assembly=AtlasOps.Geography"
    xmlns:referenceData="clr-namespace:AtlasOps.ReferenceData.Views;assembly=AtlasOps.ReferenceData"
    xmlns:operations="using:AtlasOps.Operations.Avalonia"
    xmlns:engineering="using:AtlasOps.Integrations.Engineering.Avalonia"
    xmlns:infrastructure="using:AtlasOps.Integrations.Infrastructure.Avalonia"
    xmlns:communications="using:AtlasOps.Integrations.Communications.Avalonia"
    xmlns:identityOperations="using:AtlasOps.Integrations.Identity.Avalonia"
    xmlns:viewModels="clr-namespace:AtlasOps.App.ViewModels"
    xmlns:views="clr-namespace:AtlasOps.App.Views"
    x:Class="AtlasOps.App.Views.MainWindow"
    x:DataType="viewModels:MainViewModel"
    Title="AtlasOps"
    Width="1380"
    Height="880"
    MinWidth="1080"
    MinHeight="680"
    Background="#0B1220">
    <Grid RowDefinitions="56,*,30">
        <Border Grid.Row="0" Background="#111C2E" BorderBrush="#26364F" BorderThickness="0,0,0,1">
            <Grid Margin="16,0" ColumnDefinitions="Auto,24,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#246BFD">
                        <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="AtlasOps" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WorkspaceName}" FontSize="11" Foreground="#91A1B8" />
                    </StackPanel>
                </StackPanel>
                <TextBox Grid.Column="2"
                         Width="420"
                         HorizontalAlignment="Center"
                         Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Search projects, connections, hosts, and runbooks" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="New entity" Command="{Binding AddEntityCommand}" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    <Button Content="Save all" Command="{Binding SaveCommand}" Classes="accent" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding NavigationColumnWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{Binding DetailsColumnWidth}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="#0F192A"
                    BorderBrush="#26364F"
                    BorderThickness="0,0,1,0">
                <views:NavigationRegion />
            </Border>

            <Border Grid.Column="1" Padding="18" Background="#0B1220">
                <TabControl>
                    <TabItem Header="Workspace">
                        <Grid Margin="2,14,14,14" ColumnDefinitions="5*,4*" ColumnSpacing="14">
                            <Border Padding="12" CornerRadius="8" Background="#111C2E">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedModelTitle}" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FilteredEntities.Count, StringFormat='{}{0} matching entities'}"
                                                       FontSize="11"
                                                       Foreground="#91A1B8" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Margin="0,0,8,0"
                                                Content="Add"
                                                Command="{Binding AddEntityCommand}" />
                                        <Button Grid.Column="2"
                                                Content="Delete"
                                                Command="{Binding DeleteEntityCommand}" />
                                    </Grid>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding FilteredEntities}"
                                             SelectedItem="{Binding SelectedEntitySummary, Mode=TwoWay}"
                                             Background="#0F192A">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:AtlasOpsEntitySummary">
                                                <Grid Margin="7" ColumnDefinitions="*,Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding PrimaryText}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SecondaryText}" FontSize="11" Foreground="#91A1B8" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Padding="7,2"
                                                            CornerRadius="8"
                                                            Background="#203B63"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeName}" FontSize="10" Foreground="#9CC2FF" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="#111C2E">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Generated property editor" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedEditor.DisplayName, FallbackValue='Select an entity'}"
                                                   FontSize="11"
                                                   Foreground="#91A1B8" />
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="1">
                                        <ItemsControl ItemsSource="{Binding SelectedEditor.Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:GeneratedFieldEditorViewModel">
                                                    <Grid Margin="0,0,0,10" RowDefinitions="Auto,Auto,Auto">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="{Binding TypeName}" FontSize="10" Foreground="#788BA8" />
                                                        </Grid>
                                                        <TextBox Grid.Row="1"
                                                                 Margin="0,4,0,0"
                                                                 Text="{Binding Value, Mode=TwoWay}" />
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding ValidationMessage}"
                                                                   IsVisible="{Binding HasError}"
                                                                   FontSize="11"
                                                                   Foreground="#FF7D8A" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Dashboard">
                        <ScrollViewer>
                            <StackPanel Spacing="16" Margin="2,14,14,14">
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" Padding="14" CornerRadius="8" Background="#16243A">
                                        <StackPanel>
                                            <TextBlock Text="Projects" Foreground="#91A1B8" />
                                            <TextBlock Text="{Binding Projects.Count}" FontSize="28" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="#16243A">
                                        <StackPanel>
                                            <TextBlock Text="Connections" Foreground="#91A1B8" />
                                            <TextBlock Text="{Binding Connections.Count}" FontSize="28" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Padding="14" CornerRadius="8" Background="#16243A">
                                        <StackPanel>
                                            <TextBlock Text="Capabilities" Foreground="#91A1B8" />
                                            <TextBlock Text="{Binding CapabilityCount}" FontSize="28" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Padding="14" CornerRadius="8" Background="#16243A">
                                        <StackPanel>
                                            <TextBlock Text="Implementation waves" Foreground="#91A1B8" />
                                            <TextBlock Text="{Binding CapabilityWaveCount}" FontSize="28" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="3*,2*" ColumnSpacing="14">
                                    <Border Padding="14" CornerRadius="8" Background="#111C2E">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Active projects" FontSize="18" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding Projects}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="core:AtlasOpsProject">
                                                        <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" Background="#18263B">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Owner, StringFormat='Owner: {0}'}" FontSize="12" Foreground="#91A1B8" />
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Padding="8,3" CornerRadius="10" Background="#203B63" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Stage}" FontSize="11" Foreground="#9CC2FF" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="#111C2E">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Recent activity" FontSize="18" FontWeight="SemiBold" />
                                            <ItemsControl ItemsSource="{Binding Activities}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="core:AtlasOpsActivity">
                                                        <Grid Margin="0,0,0,10" ColumnDefinitions="10,*" ColumnSpacing="9">
                                                            <Border Width="8" Height="8" CornerRadius="4" Background="#4E8CFF" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Foreground="#91A1B8" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Connections">
                        <Grid Margin="2,14,14,14" RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Text="Managed connections" FontSize="20" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Content="Add connection" />
                            </Grid>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Connections}" Background="#111C2E">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:AtlasOpsConnection">
                                        <Grid Margin="10" ColumnDefinitions="2*,2*,*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Host}" Foreground="#B7C3D4" />
                                            <TextBlock Grid.Column="2" Text="{Binding Protocol}" Foreground="#91A1B8" />
                                            <Border Grid.Column="3" Padding="8,2" CornerRadius="10" Background="#173D32">
                                                <TextBlock Text="{Binding LastStatus}" Foreground="#7DDBB2" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Capability studio">
                        <Grid Margin="2,14,14,14" ColumnDefinitions="320,*" ColumnSpacing="14">
                            <Border Padding="12" CornerRadius="8" Background="#111C2E">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="1,110-wave capability catalog" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CapabilityCount, StringFormat='{}{0} operational capability slices'}"
                                                   FontSize="11"
                                                   Foreground="#91A1B8" />
                                    </StackPanel>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding Capabilities}"
                                             SelectedItem="{Binding SelectedCapability, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="features:AtlasOpsCapabilityDescriptor">
                                                <Grid Margin="6" ColumnDefinitions="*,Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Area}" FontSize="11" Foreground="#91A1B8" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="#203B63">
                                                        <TextBlock Text="{Binding Wave, StringFormat='Wave {0}'}" FontSize="10" Foreground="#9CC2FF" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Padding="16" CornerRadius="8" Background="#111C2E">
                                <ContentControl Content="{Binding SelectedCapabilityView}" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Domain modules">
                        <Grid Margin="2,14,14,14" ColumnDefinitions="320,*" ColumnSpacing="14">
                            <Border Padding="12" CornerRadius="8" Background="#111C2E">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Modular operations catalog" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="18 independently composed domain workbenches" FontSize="11" Foreground="#91A1B8" />
                                    </StackPanel>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="composition:AtlasOpsModuleDescriptor">
                                                <Grid Margin="6" ColumnDefinitions="*,Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#91A1B8" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Padding="7,2" CornerRadius="8" Background="#203B63">
                                                        <TextBlock Text="{Binding CapabilityCount}" FontSize="10" Foreground="#9CC2FF" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Padding="4" CornerRadius="8" Background="#111C2E">
                                <ContentControl Content="{Binding SelectedModuleView}" />
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Generated editors">
                        <Grid Margin="2,14,14,14" ColumnDefinitions="2*,3*" ColumnSpacing="14">
                            <Border Padding="12" CornerRadius="8" Background="#111C2E">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Generated model sets" FontSize="18" FontWeight="SemiBold" />
                                    <ListBox ItemsSource="{Binding ModelDescriptors}"
                                             SelectedItem="{Binding SelectedModelDescriptor, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:AtlasOpsModelDescriptor">
                                                <Grid Margin="4" ColumnDefinitions="*,Auto">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#91A1B8" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Fields.Count}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="12" CornerRadius="8" Background="#111C2E">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Roslyn model catalog" FontSize="18" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding ModelDescriptors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:AtlasOpsModelDescriptor">
                                                <Border Margin="0,0,0,7" Padding="10" CornerRadius="5" Background="#18263B">
                                                    <Grid ColumnDefinitions="2*,*,Auto">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#91A1B8" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Fields.Count, StringFormat='{}{0} fields'}" Foreground="#9CC2FF" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="World geography">
                        <geography:GeographyCatalogView DataContext="{Binding Geography}" />
                    </TabItem>

                    <TabItem Header="IANA registries">
                        <referenceData:ReferenceDataWorkbenchView DataContext="{Binding IanaReferenceData}" />
                    </TabItem>

                    <TabItem Header="Software lifecycle">
                        <referenceData:ReferenceDataWorkbenchView DataContext="{Binding LifecycleReferenceData}" />
                    </TabItem>

                    <TabItem Header="Locales and time zones">
                        <referenceData:ReferenceDataWorkbenchView DataContext="{Binding LocalizationReferenceData}" />
                    </TabItem>

                    <TabItem Header="Cloud economics">
                        <referenceData:ReferenceDataWorkbenchView DataContext="{Binding CloudReferenceData}" />
                    </TabItem>

                    <TabItem Header="Geospatial operations">
                        <referenceData:ReferenceDataWorkbenchView DataContext="{Binding GeospatialReferenceData}" />
                    </TabItem>

                    <TabItem Header="Operations">
                        <TabControl Margin="2,14,14,14">
                            <TabItem Header="Command center">
                                <operations:OperationsCommandCenterView />
                            </TabItem>
                            <TabItem Header="Engineering">
                                <engineering:EngineeringWorkbenchView />
                            </TabItem>
                            <TabItem Header="Infrastructure">
                                <infrastructure:InfrastructureWorkbenchView />
                            </TabItem>
                            <TabItem Header="Communications">
                                <communications:CommunicationsWorkbenchView />
                            </TabItem>
                            <TabItem Header="Identity and service">
                                <identityOperations:IdentityOperationsView />
                            </TabItem>
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Task board">
                        <ItemsControl Margin="2,14,14,14" ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:AtlasOpsTaskItem">
                                    <Border Margin="0,0,0,9" Padding="12" CornerRadius="7" Background="#111C2E">
                                        <Grid ColumnDefinitions="2*,*,2*,80" ColumnSpacing="12">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Assignee}" Foreground="#91A1B8" />
                                            <ProgressBar Grid.Column="2" Value="{Binding Completion}" Minimum="0" Maximum="100" />
                                            <TextBlock Grid.Column="3" Text="{Binding Status}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="2"
                    Background="#0F192A"
                    BorderBrush="#26364F"
                    BorderThickness="1,0,0,0"
                    Padding="14">
                <views:DocumentRegion />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111C2E" BorderBrush="#26364F" BorderThickness="0,1,0,0">
            <Grid Margin="12,0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#A8B5C7" />
                <ProgressBar Grid.Column="1"
                             Width="120"
                             HorizontalAlignment="Center"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}" />
                <TextBlock Grid.Column="2" Text="AtlasOps · generated operations workspace" FontSize="11" Foreground="#788BA8" />
            </Grid>
        </Border>
    </Grid>
</views:MainWindow>
