<UserControl
    x:Class="AtlasOps.Geography.Views.GeographyCatalogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:AtlasOps.Geography.Domain"
    xmlns:vm="using:AtlasOps.Geography.ViewModels"
    x:DataType="vm:GeographyCatalogViewModel"
    MinWidth="920"
    MinHeight="580">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel>
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="World geography catalog" />
        <TextBlock Opacity="0.7" Text="{Binding ReleaseSummary}" />
      </StackPanel>
      <Button Command="{Binding RefreshCommand}" Content="Refresh dataset" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="12" Margin="0,16,0,12">
      <TextBox Text="{Binding SearchText}" PlaceholderText="Search by country, subdivision, code, currency, calling code, or alias" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ValidationSummary}" />
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="280,280,*,8,*" ColumnSpacing="12">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Countries" />
        <ListBox
            Grid.Row="1"
            ItemsSource="{Binding Countries}"
            SelectedItem="{Binding SelectedCountry}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="domain:Country">
              <Grid ColumnDefinitions="40,*">
                <TextBlock FontWeight="SemiBold" Text="{Binding Alpha2}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock FontSize="11" Opacity="0.65" Text="{Binding Continent}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Administrative divisions" />
        <ListBox
            Grid.Row="1"
            ItemsSource="{Binding Subdivisions}"
            SelectedItem="{Binding SelectedSubdivision}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="domain:AdministrativeDivision">
              <StackPanel>
                <TextBlock Text="{Binding Name}" />
                <TextBlock FontSize="11" Opacity="0.65" Text="{Binding Code}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <ScrollViewer Grid.Column="2">
        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Country override editor" />
          <TextBlock Opacity="0.7" Text="Source fields remain immutable; edits are stored as a local overlay." />
          <TextBlock Text="Display name" />
          <TextBox Text="{Binding EditedCountryName}" />
          <TextBlock Text="Official name" />
          <TextBox Text="{Binding EditedOfficialName}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel>
              <TextBlock Text="Currency code" />
              <TextBox Text="{Binding EditedCurrencyCode}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Calling code" />
              <TextBox Text="{Binding EditedCallingCode}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="Operator notes" />
          <TextBox MinHeight="92" AcceptsReturn="True" Text="{Binding EditedNotes}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding SaveCountryCommand}" Content="Save override" />
            <Button Command="{Binding ResetCountryCommand}" Content="Reset to source" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <Grid Grid.Column="4" RowDefinitions="Auto,*">
        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Indexed search results" />
        <ListBox Grid.Row="1" ItemsSource="{Binding SearchResults}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="domain:GeographySearchResult">
              <StackPanel Margin="4">
                <TextBlock FontWeight="SemiBold" Text="{Binding PrimaryText}" />
                <TextBlock FontSize="11" Opacity="0.65" Text="{Binding SecondaryText}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="3" Margin="0,12,0,0" Text="{Binding StatusText}" />
  </Grid>
</UserControl>
