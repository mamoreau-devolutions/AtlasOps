<views:ReferenceDataWorkbenchView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="clr-namespace:AtlasOps.ReferenceData.Infrastructure"
    xmlns:viewModels="clr-namespace:AtlasOps.ReferenceData.ViewModels"
    xmlns:views="clr-namespace:AtlasOps.ReferenceData.Views"
    x:Class="AtlasOps.ReferenceData.Views.ReferenceDataWorkbenchView"
    x:DataType="viewModels:ReferenceDataWorkbenchViewModel"
    MinWidth="820"
    MinHeight="540">
    <Grid Margin="2,14,14,14" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}" Foreground="#91A1B8" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ReleaseText}" FontSize="11" Foreground="#6F829E" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Refresh data"
                    Command="{Binding RefreshCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="2*,5*" ColumnSpacing="12">
            <ItemsControl ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ReferenceMetricViewModel">
                        <Border Margin="0,0,8,8" Padding="10,7" CornerRadius="7" Background="#16243A">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#91A1B8" />
                                <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Spacing="4">
                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Search names, identifiers, regions, categories, and metadata" />
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#91A1B8" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="12">
            <Border Padding="10" CornerRadius="8" Background="#111C2E">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="{Binding Rows.Count, StringFormat='{}{0} visible records (maximum 500)'}"
                               Margin="0,0,0,8"
                               FontWeight="SemiBold" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Rows}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                             Background="#0F192A">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="infra:ReferenceDataRow">
                                <Grid Margin="7" ColumnDefinitions="2*,5*" ColumnSpacing="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#7EA7E8" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Details}"
                                               Foreground="#A8B6CA"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Border Padding="12" CornerRadius="8" Background="#111C2E">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Selected record" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedRow.Name, FallbackValue='Select a record'}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedRow.Id}" FontSize="10" Foreground="#7EA7E8" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedRow.Details}" Foreground="#A8B6CA" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="1"
                           Text="{Binding Issues.Count, StringFormat='{}Validation findings ({0})'}"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Issues}"
                         SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"
                         Background="#111C2E">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="infra:ReferenceValidationIssue">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="#FFB454" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RecordId}" FontSize="10" Foreground="#91A1B8" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</views:ReferenceDataWorkbenchView>
