<local:ConnectorWorkbenchView
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:AtlasOps.Connectors.Contracts"
    xmlns:local="using:AtlasOps.Connectors.Avalonia"
    x:Class="AtlasOps.Connectors.Avalonia.ConnectorWorkbenchView"
    x:DataType="local:ConnectorWorkbenchViewModel"
    MinWidth="760"
    MinHeight="480">
    <Grid
        Margin="20"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="12">
        <StackPanel Spacing="3">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="{Binding Title}" />
            <TextBlock
                Opacity="0.72"
                Text="{Binding Summary}"
                TextWrapping="Wrap" />
        </StackPanel>
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8">
            <TextBox
                Text="{Binding SearchText, Mode=TwoWay}"
                PlaceholderText="Filter connectors by name, kind, or identifier" />
            <Button
                Grid.Column="1"
                Command="{Binding RefreshCommand}"
                Content="Refresh health" />
            <Button
                Grid.Column="2"
                Command="{Binding ExecuteSelectedCommand}"
                Content="Synchronize" />
        </Grid>
        <Border
            Grid.Row="2"
            Padding="10"
            Background="#16243A"
            CornerRadius="6">
            <TextBlock Text="{Binding StatusMessage}" />
        </Border>
        <Grid
            Grid.Row="3"
            ColumnDefinitions="300,5,*">
            <ListBox
                ItemsSource="{Binding Connectors}"
                SelectedItem="{Binding SelectedConnector, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="contracts:ConnectorDefinition">
                        <StackPanel
                            Margin="8"
                            Spacing="3">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding DisplayName}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="#91A1B8"
                                Text="{Binding Kind}" />
                            <TextBlock
                                FontSize="10"
                                Foreground="#9CC2FF"
                                Text="{Binding Id}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter
                Grid.Column="1"
                ResizeDirection="Columns" />
            <Grid
                Grid.Column="2"
                Margin="16,0,0,0"
                RowDefinitions="Auto,*,Auto,*"
                RowSpacing="8">
                <TextBlock
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="Health" />
                <Grid
                    Grid.Row="1"
                    RowDefinitions="Auto,*">
                    <Grid
                        Margin="8,0"
                        ColumnDefinitions="180,120,*"
                        ColumnSpacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Connector" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="State" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Message" />
                    </Grid>
                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Health}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="contracts:ConnectorHealthSnapshot">
                                <Grid
                                    ColumnDefinitions="180,120,*"
                                    ColumnSpacing="8">
                                    <TextBlock Text="{Binding ConnectorId}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding State}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <TextBlock
                    Grid.Row="2"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="Recent executions" />
                <Grid
                    Grid.Row="3"
                    RowDefinitions="Auto,*">
                    <Grid
                        Margin="8,0"
                        ColumnDefinitions="170,180,140,*"
                        ColumnSpacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Time" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Connector" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Operation" />
                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Status" />
                    </Grid>
                    <ListBox
                        Grid.Row="1"
                        ItemsSource="{Binding Executions}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="contracts:ConnectorAuditRecord">
                                <Grid
                                    ColumnDefinitions="170,180,140,*"
                                    ColumnSpacing="8">
                                    <TextBlock Text="{Binding OccurredAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ConnectorId}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Operation}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</local:ConnectorWorkbenchView>
